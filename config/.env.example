# ==================================================
# Agentic Infra Co-Pilot - Environment Configuration
# ==================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===== OpenAI Configuration =====
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Neo4j Knowledge Graph Configuration =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ===== Vector Store Configuration =====
# Options: "chromadb" or "faiss"
VECTOR_STORE_TYPE=chromadb
VECTOR_STORE_PATH=./data/vector_store

# ===== Embedding Model Configuration =====
# Options: "openai" or "sentence-transformers"
EMBEDDING_MODEL_TYPE=openai
# If using sentence-transformers:
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== Data Paths =====
DATA_RAW_TELEKOM=./data/raw/telekom
DATA_RAW_SIEMENS=./data/raw/siemens
DATA_RAW_ILLIGO=./data/raw/illigo
DATA_PROCESSED_TELEKOM=./data/processed/telekom
DATA_PROCESSED_SIEMENS=./data/processed/siemens
DATA_PROCESSED_ILLIGO=./data/processed/illigo

# ===== Logging Configuration =====
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ===== Agent Configuration =====
AGENT_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true

# ===== Simulation Configuration =====
SIMULATION_OUTPUT_DIR=./results/simulations
ENABLE_VISUALIZATION=true
